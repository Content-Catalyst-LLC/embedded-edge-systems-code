{
  "overlay_name": "privacy_preserving_stream_filter",
  "overlay_version": "0.1.0",
  "bitstream_file": "privacy_preserving_stream_filter.bit",
  "hardware_target": "pynq-compatible",
  "interfaces": [
    {"name": "raw_signal_stream", "type": "AXI-Stream", "direction": "input"},
    {"name": "derived_event_stream", "type": "AXI-Stream", "direction": "output"},
    {"name": "control", "type": "AXI-Lite", "direction": "bidirectional"}
  ],
  "governance": {
    "raw_stream_export_allowed": false,
    "requires_overlay_validation": true,
    "requires_runtime_compatibility_check": true,
    "fallback_overlay_version": "0.0.1",
    "records_privacy_evidence": true
  }
}
