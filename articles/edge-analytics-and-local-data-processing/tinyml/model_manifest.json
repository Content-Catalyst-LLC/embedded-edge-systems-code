{
  "model_name": "edge_analytics_event_classifier_stub",
  "model_version": "edge-event-0.1.0",
  "runtime_target": "tinyml-portable",
  "quantization": "int8",
  "input_schema": {
    "features": [
      {"name": "rms", "type": "float32"},
      {"name": "peak", "type": "float32"},
      {"name": "crest_factor", "type": "float32"},
      {"name": "spectral_energy", "type": "float32"},
      {"name": "bandpower_low", "type": "float32"},
      {"name": "bandpower_high", "type": "float32"}
    ]
  },
  "output_schema": {
    "labels": ["normal", "warning", "fault", "degraded"]
  },
  "governance": {
    "feature_version_required": true,
    "rule_version_required": true,
    "confidence_required": true,
    "fallback_required": true,
    "lineage_required": true
  }
}
