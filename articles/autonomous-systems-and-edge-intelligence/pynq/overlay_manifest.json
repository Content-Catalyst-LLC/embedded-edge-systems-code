{
  "overlay_name": "autonomy_sensor_preprocessor",
  "overlay_version": "0.1.0",
  "bitstream_file": "autonomy_sensor_preprocessor.bit",
  "hardware_target": "pynq-compatible",
  "interfaces": [
    {"name": "sensor_stream", "type": "AXI-Stream", "direction": "input"},
    {"name": "feature_stream", "type": "AXI-Stream", "direction": "output"},
